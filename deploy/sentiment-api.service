[Unit]
Description=Sentiment140 FastAPI
After=network-online.target mlflow.service
Wants=mlflow.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/api
Environment=MLFLOW_TRACKING_URI=http://127.0.0.1:5000
ExecStart=/home/ubuntu/api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
